---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import FaqList from '../../components/sections/FaqList.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Icon from '../../components/ui/Icon.astro';
import { LINKS } from '../../data/site';
import { serviceJsonLd, faqJsonLd, breadcrumbJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const techniques = await getCollection('techniques');
  const concerns = await getCollection('concerns');
  return techniques.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, concerns },
  }));
}

const { entry, concerns } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const path = `/techniques/${entry.id}`;

// Map this technique's helpsWith labels to concern pages where they exist.
const relatedConcerns = concerns.filter((c) =>
  data.helpsWith.includes(c.data.title),
);
---

<BaseLayout
  title={data.metaTitle}
  description={data.metaDescription}
  path={path}
  jsonLd={[
    serviceJsonLd({ name: data.title, description: data.summary, path }),
    ...(data.faqs.length ? [faqJsonLd(data.faqs)] : []),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'My Approach', path: '/approach' },
      { name: data.shortTitle ?? data.title, path },
    ]),
  ]}
>
  <PageHeader
    eyebrow="Healing Technique"
    title={data.title}
    subtitle={data.summary}
    crumbs={[
      { name: 'Home', href: '/' },
      { name: 'My Approach', href: '/approach' },
      { name: data.shortTitle ?? data.title, href: path },
    ]}
  />

  <section class="container-content py-8">
    <div class="grid gap-12 lg:grid-cols-3">
      <article
        class="prose-content lg:col-span-2 prose-soft space-y-4 [&_blockquote]:border-l-4 [&_blockquote]:border-leaf-300 [&_blockquote]:pl-4 [&_blockquote]:font-serif [&_blockquote]:text-xl [&_blockquote]:italic [&_blockquote]:text-leaf-700 [&_h2]:mt-8 [&_h2]:font-serif [&_h2]:text-2xl [&_h2]:text-leaf-900 [&_strong]:text-leaf-900"
      >
        <Content />
      </article>

      <aside class="lg:col-span-1">
        {
          relatedConcerns.length > 0 && (
            <div class="card">
              <h2 class="font-serif text-lg text-leaf-900">Helpful for</h2>
              <ul class="mt-3 space-y-2">
                {relatedConcerns.map((c) => (
                  <li>
                    <a
                      href={`/concerns/${c.id}`}
                      class="flex items-center gap-2 text-sm text-ink-soft hover:text-leaf-700"
                    >
                      <Icon name={c.data.icon} size={18} class="text-leaf-500" />
                      {c.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="card mt-6">
          <h2 class="font-serif text-lg text-leaf-900">Curious to try this?</h2>
          <p class="mt-2 text-sm text-ink-soft">
            Each session is tailored to you. Reach out to see if this approach is right for
            your journey.
          </p>
          <a href={LINKS.bookingUrl} class="btn-primary mt-4 w-full">Schedule a Consultation</a>
        </div>
        <a
          href="/approach"
          class="mt-6 inline-block text-sm font-semibold text-leaf-500 hover:text-leaf-700"
          >← All techniques</a
        >
      </aside>
    </div>
  </section>

  <FaqList faqs={data.faqs} />

  <CtaBand />
</BaseLayout>
