---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Manovana"
  description="The page you're looking for can't be found. Return home to continue exploring Manovana's mind-coaching resources."
  path="/404"
  noindex={true}
>
  <section class="container-content flex min-h-[70vh] flex-col items-center justify-center py-32 text-center">
    <p class="font-serif text-7xl font-semibold text-leaf-300">404</p>
    <h1 class="mt-4 font-serif text-3xl text-leaf-900">This path leads nowhere — yet</h1>
    <p class="prose-soft mx-auto mt-4 max-w-md">
      The page you're looking for may have moved or never existed. Let's gently guide you
      back.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn-primary">Back to Home</a>
      <a href="/approach" class="btn-secondary">Explore the Approach</a>
    </div>
  </section>
</BaseLayout>
