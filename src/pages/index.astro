---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import TestimonialCard from '../components/sections/TestimonialCard.astro';
import Icon from '../components/ui/Icon.astro';
import Ornament from '../components/ui/Ornament.astro';
import { SITE, LINKS, FREEBIES } from '../data/site';
import { CERTIFICATIONS } from '../data/certifications';
import { organizationJsonLd, personJsonLd } from '../lib/seo';

const techniques = (await getCollection('techniques')).sort(
  (a, b) => a.data.order - b.data.order,
);
const concerns = (await getCollection('concerns')).sort(
  (a, b) => a.data.order - b.data.order,
);
const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order,
);

const challenges = [
  'Doing well outside, broken inside',
  'A deep sense of emptiness',
  'Stuck in negative thinking',
  'Self-sabotaging patterns',
  'Mood swings, loneliness & low moods',
  'Entangled karmic relationships',
  'Emotional overload',
  'Striving with no inner happiness',
];

const services = [
  {
    title: '1-to-1 Coaching',
    text: 'Deeply personalised sessions tailored to your journey. Available in Kannada & English.',
    icon: 'heart',
    n: '01',
  },
  {
    title: 'Group Programs & Workshops',
    text: 'Shared healing experiences that build community and connection.',
    icon: 'users',
    n: '02',
  },
];

const beginSteps = [
  { n: 'one', title: 'Reach out', text: 'Send a message or book a slot, share as much or as little as feels right.' },
  { n: 'two', title: 'A gentle first conversation', text: 'We meet, you feel heard, and together we sense what you need.' },
  { n: 'three', title: 'Your tailored path', text: 'Malavika weaves the right techniques into a journey that is yours alone.' },
];
---

<BaseLayout
  title="Manovana | Mind Coaching with Malavika Hegde"
  description={SITE.description}
  path="/"
  jsonLd={[organizationJsonLd(), personJsonLd()]}
>
  <!-- ============ HERO ============ -->
  <section class="relative min-h-[100svh] overflow-hidden">
    <!-- realistic blossom image, anchored hard-right, feathered into the page -->
    <div class="pointer-events-none absolute inset-y-0 right-0 w-full sm:w-[68%] lg:w-[56%]">
      <img
        src="/images/hero-blossom.jpg"
        alt="Cherry blossoms in soft bloom against a clear sky, the Manovana Mind Garden"
        width="1500"
        height="993"
        class="hero-mask h-full w-full object-cover object-[60%_center]"
        fetchpriority="high"
      />
      <!-- drifting petals -->
      <span class="petal" style="left:18%; animation-delay:0s"></span>
      <span class="petal" style="left:34%; animation-delay:-6s"></span>
      <span class="petal" style="left:52%; animation-delay:-11s"></span>
      <span class="petal" style="left:68%; animation-delay:-3s"></span>
      <span class="petal" style="left:82%; animation-delay:-8s"></span>
      <span class="petal petal-sm" style="left:44%; animation-delay:-14s"></span>
      <span class="petal petal-sm" style="left:74%; animation-delay:-17s"></span>
    </div>

    <!-- mobile readability scrim (image is full-width behind text on phones) -->
    <div
      class="pointer-events-none absolute inset-0 sm:hidden"
      style="background:linear-gradient(90deg,#eef6ea 0%,rgba(238,246,234,0.92) 34%,rgba(238,246,234,0.35) 66%,transparent 100%)"
      aria-hidden="true"
    >
    </div>

    <div class="container-wide relative z-10 flex min-h-[100svh] items-center">
      <div class="max-w-xl py-28">
        <p class="eyebrow reveal">Mind Coach &amp; Counsellor · {SITE.region}</p>

        <h1 class="display split-words mt-2 text-[3rem] leading-[1.02] sm:text-6xl lg:text-7xl">
          Detox your mind.<br />Bloom your
          <span class="italic font-medium text-leaf-500">Mind&nbsp;Garden.</span>
        </h1>

        <p class="prose-soft reveal mt-7 max-w-md text-xl">
          Manovana helps minds heal, grow and bloom the flower of happiness, love and
          peace, through a holistic blend of proven healing techniques.
        </p>

        <div class="reveal mt-8 flex flex-wrap items-center gap-3">
          <a href={LINKS.bookingUrl} class="btn-primary" data-magnetic>Book a Session</a>
          <a href="/about" class="btn-secondary" data-magnetic>Meet Malavika</a>
        </div>

        <div class="reveal mt-5 flex flex-wrap items-center gap-3">
          <a
            href="/assessment"
            class="group inline-flex items-center gap-2.5 rounded-full border border-leaf-200 bg-white/60 py-1.5 pl-1.5 pr-4 text-sm font-medium text-leaf-900 shadow-sm backdrop-blur transition-colors hover:border-leaf-300 hover:bg-white"
          >
            <span class="whitespace-nowrap rounded-full bg-leaf-700 px-2.5 py-1 text-xs font-semibold text-white">Free · 2 min</span>
            <span>What's your Mind Detox Score?</span>
            <span aria-hidden="true" class="text-leaf-500 transition-transform group-hover:translate-x-0.5">→</span>
          </a>
          <a
            href="#free-gifts"
            class="group inline-flex items-center gap-2.5 rounded-full border border-leaf-200 bg-white/60 py-1.5 pl-2 pr-4 text-sm font-medium text-leaf-900 shadow-sm backdrop-blur transition-colors hover:border-leaf-300 hover:bg-white"
          >
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-leaf-700 text-white">
              <svg viewBox="0 0 24 24" class="ml-0.5 h-3 w-3" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
            </span>
            <span>Free guided meditation</span>
            <span aria-hidden="true" class="text-leaf-500 transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </div>

        <!-- hero stat strip -->
        <div class="reveal mt-14 flex flex-wrap items-center gap-x-5 gap-y-5 border-t border-leaf-200/70 pt-7 sm:flex-nowrap sm:gap-x-6">
          <div>
            <span class="block font-serif text-3xl font-semibold text-leaf-700 sm:text-4xl" data-count="21000" data-suffix="+">21,000+</span>
            <span class="whitespace-nowrap text-sm text-ink-muted">Lives impacted</span>
          </div>
          <div class="hidden h-9 w-px shrink-0 bg-leaf-200 sm:block"></div>
          <div>
            <span class="block font-serif text-3xl font-semibold text-leaf-700 sm:text-4xl" data-count="30" data-suffix="+ yrs">30+ yrs</span>
            <span class="whitespace-nowrap text-sm text-ink-muted">From IT to Mind Coaching</span>
          </div>
          <div class="hidden h-9 w-px shrink-0 bg-leaf-200 sm:block"></div>
          <div>
            <span class="block font-serif text-3xl font-semibold text-leaf-700 sm:text-4xl" data-count="12" data-suffix="+">12+</span>
            <span class="whitespace-nowrap text-sm text-ink-muted">Coaching modalities</span>
          </div>
        </div>
      </div>
    </div>

    <!-- scroll cue -->
    <div class="absolute inset-x-0 bottom-6 z-10 flex justify-center">
      <div class="flex flex-col items-center gap-2 text-xs uppercase tracking-[0.25em] text-leaf-500">
        <span>Scroll</span>
        <span class="h-10 w-px animate-pulse bg-leaf-300"></span>
      </div>
    </div>
  </section>

  <!-- ============ MIND TRUTHS ============ -->
  <section id="truths" class="relative scroll-mt-24 overflow-hidden py-20 sm:py-28">
    <!-- calm wash + faint tree-in-mind watermark (no blossom) -->
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-leaf-50 via-sky-100/40 to-leaf-100/70"></div>
    <img
      src="/images/emblem.png"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-1/2 -z-10 w-[460px] max-w-[78%] -translate-x-1/2 -translate-y-1/2 opacity-[0.06]"
      loading="lazy"
      data-parallax="0.08"
    />

    <div class="container-content text-center">
      <Ornament class="mx-auto mb-6 h-11 w-11" />
      <blockquote class="reveal mx-auto mt-8 max-w-3xl font-serif text-[1.9rem] italic leading-[1.32] text-ink sm:text-[2.7rem]">
        “Your Mind is a Garden,<br />
        your Thoughts are the Seeds.<br />
        <span class="text-leaf-700 not-italic">You can grow Flowers,</span><br />
        or weeds…”
      </blockquote>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section class="relative py-14 sm:py-20">
    <div class="container-wide">
      <div class="grid items-center gap-14 lg:grid-cols-[0.9fr_1.1fr]">
        <!-- portrait -->
        <div class="reveal relative order-2 lg:order-1">
          <div class="relative mx-auto aspect-[4/5] max-w-md overflow-hidden rounded-[2.5rem] border border-white/70 bg-gradient-to-br from-sky-100 via-cream to-leaf-100 shadow-[0_40px_90px_-40px_rgba(91,140,90,0.5)]">
            <img
              src="/images/malavika-hegde.jpg"
              alt="Malavika Hegde, Mind Coach & Counsellor at Manovana"
              width="885"
              height="1600"
              class="h-full w-full object-cover object-[50%_18%]"
              loading="lazy"
            />
          </div>
        </div>
        <!-- text -->
        <div class="order-1 lg:order-2">
          <span class="eyebrow reveal">meet your coach</span>
          <h2 class="split-words section-title max-w-xl">
            From Systems to Souls, Logic to Light.
          </h2>
          <div class="mt-7 space-y-5 prose-soft max-w-xl">
            <p class="reveal">
              An IT professional for over 30 years, Malavika Hegde made a transformative
              shift into mind coaching, tuning into her soul-driven purpose to become a
              Mind Coach and Counsellor.
            </p>
            <p class="reveal border-l-2 border-leaf-300 pl-5 font-serif text-2xl italic leading-snug text-leaf-700">
              “I understand the silent struggles of people who display happiness and
              success on the outside while carrying loads of pain from the inside.”
            </p>
          </div>
          <a href="/about" class="btn-secondary reveal mt-9" data-magnetic>Read her story</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CREDENTIALS BADGES ============ -->
  <section class="relative py-12 sm:py-16">
    <div class="container-wide">
      <div class="reveal relative overflow-hidden rounded-[2.2rem] border border-leaf-100 bg-white/70 px-6 py-10 shadow-[0_22px_60px_-34px_rgba(91,140,90,0.4)] sm:px-10">
        <div class="mx-auto max-w-2xl text-center">
          <span class="eyebrow justify-center">certified &amp; accredited</span>
          <h2 class="font-serif text-2xl text-leaf-900 sm:text-3xl">
            Trained across {CERTIFICATIONS.length} professional certifications
          </h2>
          <p class="prose-soft mt-3">
            In coaching, counselling and holistic healing, so you're always in
            experienced, qualified hands.
          </p>
        </div>
        <ul class="mt-8 flex flex-wrap justify-center gap-2.5">
          {
            CERTIFICATIONS.map((c) => (
              <li class="inline-flex items-center gap-2 rounded-full border border-leaf-100 bg-leaf-50/70 px-4 py-2 text-sm font-medium text-leaf-900">
                <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-leaf-500" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z" />
                  <path d="M8.5 13.5 7 22l5-3 5 3-1.5-8.5" />
                </svg>
                {c.short}
              </li>
            ))
          }
        </ul>
        <div class="mt-8 text-center">
          <a href="/about#certifications" class="btn-secondary" data-magnetic>See the certificates</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHO IS THIS FOR ============ -->
  <section class="relative py-14 sm:py-20">
    <div class="container-wide">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <span class="eyebrow reveal">who is this for</span>
          <h2 class="split-words section-title max-w-md">
            For anyone carrying pain the world can't see.
          </h2>
        </div>
        <div>
          <p class="prose-soft reveal">
            Anyone aged 18–80, working professionals, homemakers and retired personnel.
            Especially those who feel any of this:
          </p>
          <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2">
            {
              challenges.map((c) => (
                <li class="reveal flex items-start gap-3 border-b border-leaf-100 pb-3 text-ink-soft">
                  <Icon name="leaf" size={18} class="mt-1 shrink-0 text-leaf-500" />
                  <span>{c}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHAT I HELP WITH ============ -->
  <section id="help-with" class="relative scroll-mt-24 py-14 sm:py-20">
    <div class="container-wide">
      <div class="reveal mx-auto max-w-2xl text-center">
        <Ornament class="mx-auto mb-4 h-10 w-10" />
        <span class="eyebrow justify-center">how I help</span>
        <h2 class="section-title">
          Guiding you towards clarity, peace and emotional freedom.
        </h2>
      </div>
      <!-- a winding garden path: each concern is a bloom along the vine -->
      <div class="relative mx-auto mt-16 max-w-3xl">
        <span
          class="vine absolute left-[26px] top-3 bottom-3 w-[2px] md:left-1/2 md:-translate-x-1/2"
          aria-hidden="true"
        ></span>
        <ul class="space-y-12 md:space-y-16">
          {
            concerns.map((c, i) => {
              const left = i % 2 === 0;
              return (
                <li class="reveal relative">
                  <span class="absolute left-[26px] top-0 z-10 flex h-[52px] w-[52px] -translate-x-1/2 items-center justify-center rounded-full border border-leaf-100 bg-white text-leaf-700 shadow-[0_8px_22px_-10px_rgba(91,140,90,0.5)] md:left-1/2">
                    <Icon name={c.data.icon} size={22} />
                  </span>
                  <a
                    href={`/concerns/${c.id}`}
                    class:list={[
                      'group block pl-20 md:w-[46%] md:pl-0',
                      left ? 'md:pr-12 md:text-right' : 'md:ml-auto md:pl-12 md:text-left',
                    ]}
                  >
                    <h3 class="font-serif text-[1.7rem] italic leading-tight text-leaf-900 transition-colors group-hover:text-leaf-500 sm:text-3xl">
                      {c.data.title}
                    </h3>
                    <p class="mt-2 leading-relaxed text-ink-soft">{c.data.summary}</p>
                    <span class:list={['mt-3 inline-flex items-center gap-2 text-sm font-semibold text-leaf-500', left && 'md:flex-row-reverse']}>
                      Explore
                      <span aria-hidden="true">✿</span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ APPROACH (04) — a garland of techniques ============ -->
  <section id="approach" class="relative scroll-mt-24 pt-14 pb-10 sm:pt-20 sm:pb-14">
    <div class="container-content text-center">
      <Ornament class="mx-auto mb-4 h-10 w-10" />
      <span class="eyebrow justify-center">my approach</span>
      <h2 class="section-title mx-auto max-w-2xl">
        A holistic blend of proven healing techniques.
      </h2>
      <p class="prose-soft reveal mx-auto mt-5 max-w-xl">
        No single tool fits every mind. Malavika weaves these modalities together,
        tailored gently to you.
      </p>

      <!-- the methodology as a structured system of modalities -->
      <div class="reveal mx-auto mt-14 grid max-w-5xl gap-px overflow-hidden rounded-2xl border border-leaf-100 bg-leaf-100 text-left sm:grid-cols-2 lg:grid-cols-3">
        {
          techniques.map((t) => {
            const sub = t.data.shortTitle && t.data.shortTitle !== t.data.title ? t.data.title : null;
            return (
              <a
                href={`/techniques/${t.id}`}
                class="group flex items-start gap-4 bg-stone-50 p-6 transition-colors duration-300 hover:bg-white"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-leaf-100 bg-white text-leaf-700 transition-colors group-hover:border-leaf-300">
                  <Icon name={t.data.icon} size={20} />
                </span>
                <span class="min-w-0">
                  <span class="block font-serif text-lg leading-tight text-leaf-900 transition-colors group-hover:text-leaf-700">
                    {t.data.shortTitle ?? t.data.title}
                  </span>
                  {sub && <span class="mt-0.5 block text-xs leading-snug text-ink-muted">{sub}</span>}
                </span>
              </a>
            );
          })
        }
      </div>

      <a href="/approach" class="btn-secondary reveal mt-10" data-magnetic>
        Explore the full approach
      </a>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="relative pt-8 pb-14 sm:pt-10 sm:pb-20">
    <div class="container-wide">
      <div class="reveal mx-auto max-w-2xl text-center">
        <Ornament class="mx-auto mb-4 h-10 w-10" />
        <span class="eyebrow justify-center">ways to work together</span>
        <h2 class="section-title">Gentle, guided paths to healing.</h2>
      </div>
      <!-- calm medallions: gradient orb + delicate rotating seed-dot halo + crisp icon -->
      <div class="mt-16 grid max-w-2xl gap-12 sm:mx-auto sm:grid-cols-2 sm:gap-8">
        {
          services.map((s, i) => {
            const tints = [
              'from-stone-100 via-white to-leaf-50',
              'from-leaf-100 via-white to-stone-50',
              'from-stone-200 via-white to-leaf-50',
            ];
            return (
              <a href="/services" class="reveal group block text-center">
                <div class={`relative mx-auto aspect-square max-w-[210px] rounded-full bg-gradient-to-br ${tints[i % tints.length]} shadow-[0_34px_74px_-36px_rgba(91,140,90,0.55)] ring-1 ring-inset ring-white/60 transition-all duration-500 group-hover:-translate-y-2 group-hover:shadow-[0_44px_88px_-38px_rgba(91,140,90,0.62)]`}>
                  <svg viewBox="0 0 100 100" aria-hidden="true" class="ring-spin absolute inset-0 h-full w-full text-leaf-300">
                    <circle cx="50" cy="50" r="44" fill="none" stroke="currentColor" stroke-width="0.5" stroke-dasharray="0.4 4.6" stroke-linecap="round" />
                    <circle cx="50" cy="50" r="38" fill="none" stroke="currentColor" stroke-width="0.3" opacity="0.5" />
                  </svg>
                  <div class="absolute inset-0 flex items-center justify-center">
                    <span class="flex h-[82px] w-[82px] items-center justify-center rounded-full bg-white/85 text-leaf-700 shadow-[0_10px_26px_-12px_rgba(91,140,90,0.6)] backdrop-blur-sm transition-transform duration-500 group-hover:scale-105">
                      <Icon name={s.icon} size={34} />
                    </span>
                  </div>
                </div>
                <h3 class="mt-7 font-serif text-2xl italic text-leaf-900 transition-colors group-hover:text-leaf-500">{s.title}</h3>
                <p class="mx-auto mt-2 max-w-xs leading-relaxed text-ink-soft">{s.text}</p>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="relative py-14 sm:py-20">
    <div class="container-wide">
      <div class="reveal mx-auto max-w-2xl text-center">
        <Ornament class="mx-auto mb-4 h-10 w-10" />
        <span class="eyebrow justify-center">words from the heart</span>
        <h2 class="section-title">Real reflections from real sessions.</h2>
      </div>

      <div class="reveal mx-auto mt-14 grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          testimonials.slice(0, 6).map((t) => (
            <TestimonialCard
              id={t.id}
              name={t.data.name}
              context={t.data.context}
              quote={t.data.quote}
              image={t.data.image}
            />
          ))
        }
      </div>

      <div class="mt-12 text-center">
        <a href="/testimonials" class="btn-secondary" data-magnetic>Read more reflections</a>
      </div>
    </div>
  </section>

  <!-- ============ HOW WE BEGIN ============ -->
  <section class="relative py-14 sm:py-20">
    <div class="container-wide">
      <div class="reveal mx-auto max-w-2xl text-center">
        <Ornament class="mx-auto mb-4 h-10 w-10" />
        <span class="eyebrow justify-center">how we begin</span>
        <h2 class="section-title">Starting is gentler than you think.</h2>
      </div>
      <div class="relative mx-auto mt-16 grid max-w-4xl gap-12 sm:grid-cols-3 sm:gap-8">
        <span class="vine absolute left-0 right-0 top-7 hidden h-[2px] w-full sm:block" aria-hidden="true"></span>
        {
          beginSteps.map((step) => (
            <div class="reveal relative text-center">
              <span class="relative z-10 mx-auto flex h-14 w-14 items-center justify-center rounded-full border border-leaf-100 bg-white font-serif text-lg italic text-leaf-700 shadow-[0_10px_24px_-12px_rgba(91,140,90,0.5)]">
                {step.n}
              </span>
              <h3 class="mt-6 font-serif text-2xl italic text-leaf-900">{step.title}</h3>
              <p class="mx-auto mt-2 max-w-xs leading-relaxed text-ink-soft">{step.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ FREE GIFTS — two gentle ways to begin ============ -->
  <section id="free-gifts" class="relative scroll-mt-24 py-14 sm:py-20">
    <div class="container-wide">
      <div class="reveal mx-auto mb-10 max-w-2xl text-center">
        <span class="eyebrow justify-center">free gifts to begin</span>
        <h2 class="section-title">Start your healing today, on the house.</h2>
        <p class="prose-soft mt-3">Two gentle, no-cost ways to take your first step inward.</p>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        <!-- Gift 1: free Mind Detox Scorecard -->
        <a
          href="/assessment"
          class="reveal group relative flex flex-col overflow-hidden rounded-[2.2rem] border border-leaf-100 bg-gradient-to-br from-leaf-50 via-white to-sky-100 px-7 py-9 shadow-[0_22px_60px_-32px_rgba(91,140,90,0.4)] transition-transform duration-300 hover:-translate-y-1 sm:px-10"
          data-magnetic
        >
          <span class="inline-flex w-fit items-center gap-2 rounded-full bg-leaf-700 px-3 py-1 text-xs font-semibold text-white">Free · 2 min</span>
          <div class="mt-5 flex gap-1.5" aria-hidden="true">
            {[0, 1, 2, 3, 4].map((n) => (
              <svg viewBox="0 0 24 24" class={`h-7 w-7 ${n < 3 ? 'fill-[#f4b740] stroke-[#e0a020]' : 'fill-transparent stroke-leaf-300'}`} stroke-width="1.4" stroke-linejoin="round">
                <path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 18.9 6.1 21.5l1.2-6.5L2.5 9.4l6.6-.9z" />
              </svg>
            ))}
          </div>
          <h3 class="mt-5 font-serif text-2xl text-leaf-900 sm:text-3xl">What's your Mind Detox Score?</h3>
          <p class="prose-soft mt-3 flex-1">
            Rate 5 simple statements and instantly discover your mental clutter score, with a
            personalised next step toward calm.
          </p>
          <span class="btn-primary mt-7 w-fit">Take the free Scorecard →</span>
        </a>

        <!-- Gift 2: free guided practice (email capture) -->
        <div class="reveal relative flex flex-col overflow-hidden rounded-[2.2rem] border border-leaf-100 bg-white/70 px-7 py-9 shadow-[0_22px_60px_-32px_rgba(91,140,90,0.4)] sm:px-10">
          <img src="/images/emblem.png" alt="" aria-hidden="true" class="pointer-events-none absolute -right-8 -top-8 w-40 opacity-[0.07]" loading="lazy" />
          <div class="relative flex flex-1 flex-col">
            <span class="inline-flex w-fit items-center gap-2 rounded-full bg-leaf-100 px-3 py-1 text-xs font-semibold text-leaf-700">Free guided practice</span>
            <h3 class="mt-5 font-serif text-2xl text-leaf-900 sm:text-3xl">Detox Your Mind, a guided meditation</h3>
            <p class="prose-soft mt-3 flex-1">
              A short practice to quieten a racing mind and return to calm. Leave your email and
              it downloads instantly, yours to keep.
            </p>
            <form
              id="freebie-form"
              name="freebie"
              method="POST"
              data-netlify="true"
              netlify-honeypot="bot-field"
              action="/thank-you"
              class="mt-6 flex flex-col gap-3 sm:flex-row"
            >
              <input type="hidden" name="form-name" value="freebie" />
              <p class="hidden"><label>Leave blank if human: <input name="bot-field" /></label></p>
              <label class="sr-only" for="freebie-email">Your email</label>
              <input
                id="freebie-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@email.com"
                class="flex-1 rounded-full border border-leaf-100 bg-white px-5 py-3 text-ink outline-none focus:border-leaf-500"
              />
              <button type="submit" class="btn-primary whitespace-nowrap">Send it to me</button>
            </form>
            <label class="mt-3 flex cursor-pointer items-start gap-2.5 text-xs text-ink-muted">
              <input type="checkbox" name="consent" required value="yes" form="freebie-form"
                class="mt-0.5 h-4 w-4 shrink-0 rounded border-leaf-200 text-leaf-700 focus:ring-leaf-500" />
              <span>I agree to receive this practice and occasional gentle emails from Manovana. No spam, ever.</span>
            </label>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FREEBIE SUCCESS POPUP ============ -->
  <div
    id="freebie-modal"
    data-audio-url={FREEBIES.meditationAudioUrl}
    data-audio-filename={FREEBIES.meditationFileName}
    class="invisible fixed inset-0 z-50 flex items-center justify-center p-5 opacity-0 transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-labelledby="freebie-modal-title"
  >
    <div class="absolute inset-0 bg-leaf-900/50 backdrop-blur-sm" data-freebie-close></div>
    <div class="relative w-full max-w-sm rounded-[2rem] border border-leaf-100 bg-white p-8 text-center shadow-[0_40px_90px_-30px_rgba(34,56,44,0.6)]">
      <button
        type="button"
        data-freebie-close
        aria-label="Close"
        class="absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full text-ink-muted hover:bg-leaf-50 hover:text-leaf-700"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
      </button>
      <p class="text-4xl" aria-hidden="true">🌿</p>
      <h3 id="freebie-modal-title" class="mt-3 font-serif text-2xl text-leaf-900">
        Your meditation is downloading…
      </h3>
      <p class="prose-soft mt-2 text-sm">
        Check your downloads for
        <em>“Detox Your Mind”</em>, then find a quiet corner, breathe out, and press play.
      </p>
      <a
        data-freebie-download
        href={FREEBIES.meditationAudioUrl}
        download={FREEBIES.meditationFileName}
        class="btn-primary mt-5 w-full"
      >
        Didn't start? Download again ↓
      </a>
      <p class="mt-3 text-xs text-ink-muted">Yours to keep, listen anytime, anywhere.</p>
    </div>
  </div>

  <script>
    const freebieForm = document.getElementById('freebie-form') as HTMLFormElement | null;
    const modal = document.getElementById('freebie-modal');
    if (freebieForm && modal) {
      const audioUrl = modal.dataset.audioUrl || '';
      const audioFileName = modal.dataset.audioFilename || 'meditation.mp4';

      const hide = () => {
        modal.classList.add('opacity-0');
        window.setTimeout(() => modal.classList.add('invisible'), 300);
      };
      modal.querySelectorAll('[data-freebie-close]').forEach((el) =>
        el.addEventListener('click', hide),
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') hide();
      });

      const triggerDownload = () => {
        const a = document.createElement('a');
        a.href = audioUrl;
        a.download = audioFileName;
        document.body.appendChild(a);
        a.click();
        a.remove();
      };

      freebieForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!freebieForm.reportValidity()) return;

        // best-effort lead capture via Netlify Forms (no-op in local preview)
        try {
          await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(new FormData(freebieForm) as any).toString(),
          });
        } catch (_) {
          /* offline / local — still deliver the meditation */
        }

        triggerDownload();
        modal.classList.remove('invisible');
        requestAnimationFrame(() => modal.classList.remove('opacity-0'));
        freebieForm.reset();
      });
    }
  </script>

  <!-- ============ THE MEANING — Mano + Vana, a closing reflection before the ask ============ -->
  <section class="relative py-14 sm:py-20">
    <div class="container-wide">
      <div class="grid items-center gap-10 lg:grid-cols-[auto_1fr] lg:gap-16">
        <div class="reveal mx-auto">
          <img
            src="/images/emblem.png"
            alt="The Manovana emblem, a tree growing within a human mind"
            width="208"
            height="208"
            class="h-44 w-44 animate-float lg:h-56 lg:w-56"
            loading="lazy"
          />
        </div>
        <div>
          <span class="eyebrow reveal">the meaning of Manovana</span>
          <p class="reveal font-serif text-2xl italic leading-relaxed text-ink sm:text-[1.9rem]">
            <span class="font-medium not-italic text-leaf-700">Mano</span>, the mind.
            <span class="font-medium not-italic text-leaf-700">Vana</span>, a forest, a
            garden. Manovana is the <span class="text-leaf-700">garden of your mind</span>:
            a place to tend what hurts, and let happiness, love and peace bloom.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
