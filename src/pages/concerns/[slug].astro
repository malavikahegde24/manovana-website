---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import FaqList from '../../components/sections/FaqList.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Icon from '../../components/ui/Icon.astro';
import { LINKS } from '../../data/site';
import { serviceJsonLd, faqJsonLd, breadcrumbJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const concerns = await getCollection('concerns');
  const techniques = await getCollection('techniques');
  return concerns.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, techniques },
  }));
}

const { entry, techniques } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const path = `/concerns/${entry.id}`;

const related = data.relatedTechniques
  .map((slug) => techniques.find((t) => t.id === slug))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));
---

<BaseLayout
  title={data.metaTitle}
  description={data.metaDescription}
  path={path}
  jsonLd={[
    serviceJsonLd({
      name: `Coaching for ${data.title}`,
      description: data.summary,
      path,
    }),
    ...(data.faqs.length ? [faqJsonLd(data.faqs)] : []),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'What I Help With', path: '/#help-with' },
      { name: data.title, path },
    ]),
  ]}
>
  <PageHeader
    eyebrow="What I Help With"
    title={data.title}
    subtitle={data.summary}
    crumbs={[
      { name: 'Home', href: '/' },
      { name: 'What I Help With', href: '/#help-with' },
      { name: data.title, href: path },
    ]}
  />

  <section class="container-content py-8">
    <div class="grid gap-12 lg:grid-cols-3">
      <article
        class="lg:col-span-2 prose-soft space-y-4 [&_h2]:mt-8 [&_h2]:font-serif [&_h2]:text-2xl [&_h2]:text-leaf-900 [&_strong]:text-leaf-900"
      >
        <Content />
      </article>

      <aside class="lg:col-span-1">
        {
          related.length > 0 && (
            <div class="card">
              <h2 class="font-serif text-lg text-leaf-900">Techniques that help</h2>
              <ul class="mt-3 space-y-2">
                {related.map((t) => (
                  <li>
                    <a
                      href={`/techniques/${t.id}`}
                      class="flex items-center gap-2 text-sm text-ink-soft hover:text-leaf-700"
                    >
                      <Icon name={t.data.icon} size={18} class="text-leaf-500" />
                      {t.data.shortTitle ?? t.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="card mt-6">
          <h2 class="font-serif text-lg text-leaf-900">You don't have to do this alone</h2>
          <p class="mt-2 text-sm text-ink-soft">
            If this resonates, a gentle first conversation can help you find your way
            forward.
          </p>
          <a href={LINKS.bookingUrl} class="btn-primary mt-4 w-full">Book a Session</a>
        </div>
        <a
          href="/#help-with"
          class="mt-6 inline-block text-sm font-semibold text-leaf-500 hover:text-leaf-700"
          >← All areas I help with</a
        >
      </aside>
    </div>
  </section>

  <FaqList faqs={data.faqs} />

  <CtaBand />
</BaseLayout>
