---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
---

<BaseLayout
  title="Message Sent — Thank You | Manovana"
  description="Thank you for reaching out to Manovana. Your message has been received and Malavika will get back to you soon."
  path="/contact/success"
  noindex={true}
>
  <section class="container-content flex min-h-[70vh] flex-col items-center justify-center py-32 text-center">
    <div
      class="mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-leaf-100 text-leaf-700"
    >
      <Icon name="sprout" size={40} />
    </div>
    <h1 class="font-serif text-4xl text-leaf-900">Thank you for reaching out</h1>
    <p class="prose-soft mx-auto mt-4 max-w-lg">
      Your message has been received. Malavika will personally get back to you soon. In the
      meantime, take a deep breath — you've just taken a meaningful first step.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn-primary">Back to Home</a>
      <a href="/articles" class="btn-secondary">Read an Article</a>
    </div>
  </section>
</BaseLayout>
