---
/**
 * Testimonial avatar. Uses a real image when provided, otherwise a tasteful
 * initials placeholder. `size` is the diameter in pixels.
 */
interface Props {
  name: string;
  image?: string;
  size?: number;
  class?: string;
}
const { name, image, size = 48, class: className = '' } = Astro.props;
const initials = name
  .split(' ')
  .map((w) => w[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('')
  .toUpperCase();
const dim = `width:${size}px;height:${size}px`;
const spanStyle = `${dim};font-size:${Math.round(size * 0.34)}px`;
---

{
  image ? (
    <img
      src={image}
      alt={`Photo of ${name}`}
      width={size}
      height={size}
      loading="lazy"
      style={dim}
      class={`shrink-0 rounded-full object-cover ${className}`}
    />
  ) : (
    <span
      style={spanStyle}
      class={`flex shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-leaf-300 to-sky-300 font-serif font-semibold leading-none text-leaf-900 ${className}`}
      aria-hidden="true"
    >
      {initials}
    </span>
  )
}
