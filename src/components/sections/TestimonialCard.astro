---
import Avatar from '../ui/Avatar.astro';
interface Props {
  name: string;
  context?: string;
  quote: string;
  image?: string;
}
const { name, context, quote, image } = Astro.props;
---

<figure class="card flex h-full flex-col">
  <svg
    class="mb-3 h-7 w-7 text-leaf-300"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M9.5 6C6.5 6 4 8.5 4 11.5c0 2.6 1.9 4.5 4.3 4.5.3 0 .6 0 .9-.1-.6 1.6-2 2.8-3.7 3.3l.6 1.8c3.5-1 6-4.2 6-8.3C12 9 11 6 9.5 6Zm9 0C15.5 6 13 8.5 13 11.5c0 2.6 1.9 4.5 4.3 4.5.3 0 .6 0 .9-.1-.6 1.6-2 2.8-3.7 3.3l.6 1.8c3.5-1 6-4.2 6-8.3C21 9 20 6 18.5 6Z"
    ></path>
  </svg>
  <blockquote class="flex-1 text-ink-soft">{quote}</blockquote>
  <figcaption class="mt-5 flex items-center gap-3">
    <Avatar name={name} image={image} />
    <span>
      <span class="block text-sm font-semibold text-leaf-900">{name}</span>
      {context && <span class="block text-xs text-ink-muted">{context}</span>}
    </span>
  </figcaption>
</figure>
