---
interface Crumb {
  name: string;
  href: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, subtitle, crumbs = [] } = Astro.props;
---

<header class="container-content pb-6 pt-32 sm:pt-36">
  {
    crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-5">
        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-ink-muted">
          {crumbs.map((c, i) => (
            <li class="flex items-center gap-1.5">
              {i > 0 && <span aria-hidden="true">/</span>}
              {i < crumbs.length - 1 ? (
                <a href={c.href} class="hover:text-leaf-700">
                  {c.name}
                </a>
              ) : (
                <span class="text-leaf-700" aria-current="page">
                  {c.name}
                </span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )
  }
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h1 class="max-w-3xl font-serif text-4xl leading-tight text-leaf-900 sm:text-5xl">
    {title}
  </h1>
  {subtitle && <p class="prose-soft mt-4 max-w-2xl">{subtitle}</p>}
</header>
