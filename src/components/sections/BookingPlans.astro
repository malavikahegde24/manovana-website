---
/**
 * Reusable "book a paid session" flow: choose one of OFFERS.plans, pay via a
 * per-plan UPI deep link + build-time QR, then confirm via the Google Form.
 * Used standalone on /book and embedded in the Mind Detox Scorecard result.
 */
import QRCode from 'qrcode';
import { OFFERS } from '../../data/site';

interface Props {
  heading?: string;
  intro?: string;
}

const {
  heading = 'Book a call with Malavika',
  intro = 'Two quick steps to book your session:',
} = Astro.props;

// Per-plan UPI deep link + a self-generated QR (works on desktop by scanning, mobile by tapping).
const plans = await Promise.all(
  OFFERS.plans.map(async (plan) => {
    const upiUri =
      `upi://pay?pa=${OFFERS.upiId}` +
      `&pn=${encodeURIComponent(OFFERS.payeeName)}` +
      `&am=${plan.amount}&cu=INR` +
      `&tn=${encodeURIComponent(`Manovana — ${plan.label}`)}`;
    const qr = await QRCode.toDataURL(upiUri, {
      width: 320,
      margin: 1,
      color: { dark: '#22382c', light: '#ffffff' },
    });
    return { ...plan, upiUri, qr };
  }),
);
---

<div class="mx-auto max-w-md rounded-2xl border border-leaf-100 bg-leaf-50/50 p-6 sm:p-7">
  <h2 class="text-center font-serif text-xl text-leaf-900">{heading}</h2>
  <p class="prose-soft mt-2 text-center text-sm">{intro}</p>

  <!-- Step 1 — choose a plan & pay -->
  <div class="mt-5 rounded-xl border border-leaf-100 bg-white p-5">
    <p class="flex items-center gap-2 font-serif text-base text-leaf-900">
      <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-leaf-700 text-xs font-semibold text-white">1</span>
      Choose a plan &amp; pay
    </p>
    <div class="mt-4 space-y-3">
      {
        plans.map((plan) => (
          <div class="relative rounded-lg border border-leaf-100 p-4">
            {'discount' in plan && plan.discount && (
              <span class="absolute -top-2.5 right-4 rounded-full bg-leaf-700 px-2.5 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide text-white shadow-sm">
                {plan.discount}
              </span>
            )}
            <div class="flex items-center justify-between gap-3">
              <p class="text-sm font-medium text-leaf-900">{plan.label}</p>
              <p class="whitespace-nowrap text-right">
                {'originalPrice' in plan && plan.originalPrice && (
                  <span class="mr-1.5 text-sm text-ink-muted line-through">{plan.originalPrice}</span>
                )}
                <span class="font-serif text-lg text-leaf-700">{plan.price}</span>
              </p>
            </div>
            <a href={plan.upiUri} class="btn-primary mt-3 w-full">Pay {plan.price} via UPI</a>
            <details class="mt-3">
              <summary class="cursor-pointer text-center text-xs text-ink-muted underline">
                On a computer? Scan from any UPI app
              </summary>
              <img src={plan.qr} alt={`UPI QR code to pay ${plan.price} for ${plan.label}`}
                width="150" height="150" class="mx-auto mt-2 h-32 w-32 rounded-lg border border-leaf-100 bg-white p-2" loading="lazy" />
            </details>
          </div>
        ))
      }
    </div>
    <p class="mt-3 text-center text-xs text-ink-muted">
      UPI ID: <button type="button" data-copy-upi class="font-semibold text-leaf-700 underline">{OFFERS.upiId}</button>
    </p>
  </div>

  <!-- Step 2 — booking form -->
  <div class="mt-4 rounded-xl border border-leaf-100 bg-white p-5">
    <p class="flex items-center gap-2 font-serif text-base text-leaf-900">
      <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-leaf-700 text-xs font-semibold text-white">2</span>
      Fill the form
    </p>
    <p class="mt-1 text-sm text-ink-soft">
      Share your details along with a screenshot of your payment — Malavika will confirm your session.
    </p>
    <a href={OFFERS.bookingFormUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary mt-4 w-full">
      Open the booking form →
    </a>
  </div>
</div>

<script>
  // tap-to-copy the UPI ID — scoped per instance so multiple copies on one page (if ever) each work
  document.querySelectorAll<HTMLButtonElement>('[data-copy-upi]').forEach((copyBtn) => {
    copyBtn.addEventListener('click', async () => {
      const id = copyBtn.textContent?.trim() || '';
      try {
        await navigator.clipboard.writeText(id);
        const original = copyBtn.textContent;
        copyBtn.textContent = 'Copied ✓';
        window.setTimeout(() => { copyBtn.textContent = original; }, 1600);
      } catch (_) {
        /* clipboard unavailable — the id is still visible to copy manually */
      }
    });
  });
</script>
