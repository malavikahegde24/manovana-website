---
/**
 * Reusable "book a paid session" flow: shows the plan(s) from OFFERS.plans,
 * then a single CTA to the Google Form, where payment (UPI ID + QR) and
 * booking details are all handled together.
 * Used standalone on /book and embedded in the Mind Detox Scorecard result.
 */
import { OFFERS } from '../../data/site';

interface Props {
  heading?: string;
  intro?: string;
}

const {
  heading = 'Book a call with Malavika',
  intro = 'Your session:',
} = Astro.props;

const plans = OFFERS.plans;
---

<div class="mx-auto max-w-md rounded-2xl border border-leaf-100 bg-leaf-50/50 p-6 sm:p-7">
  <h2 class="text-center font-serif text-xl text-leaf-900">{heading}</h2>
  <p class="prose-soft mt-2 text-center text-sm">{intro}</p>

  <!-- Plan(s) -->
  <div class="mt-5 space-y-3">
    {
      plans.map((plan) => (
        <div class="relative rounded-xl border border-leaf-100 bg-white p-4">
          {'discount' in plan && plan.discount && (
            <span class="absolute -top-2.5 right-4 rounded-full bg-leaf-700 px-2.5 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide text-white shadow-sm">
              {plan.discount}
            </span>
          )}
          <div class="flex items-center justify-between gap-3">
            <p class="text-sm font-medium text-leaf-900">{plan.label}</p>
            <p class="whitespace-nowrap text-right">
              {'originalPrice' in plan && plan.originalPrice && (
                <span class="mr-1.5 text-sm text-ink-muted line-through">{plan.originalPrice}</span>
              )}
              <span class="font-serif text-lg text-leaf-700">{plan.price}</span>
            </p>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Booking form — payment (UPI ID + QR) and details are all inside it -->
  <div class="mt-4 rounded-xl border border-leaf-100 bg-white p-5">
    <p class="text-sm text-ink-soft">
      Fill in your details and complete payment, the UPI ID, QR code, and a place to
      attach your payment screenshot are all in the form. Malavika will confirm your
      session once it's submitted.
    </p>
    <a href={OFFERS.bookingFormUrl} target="_blank" rel="noopener noreferrer" class="btn-primary mt-4 w-full">
      Open the booking form →
    </a>
  </div>
</div>
